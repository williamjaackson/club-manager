# Create a bot at https://discord.com/developers/applications and paste its token.
DISCORD_TOKEN=replace-me

# Recommended while developing: commands registered to one server appear quickly.
# Omit this to register global commands, which can take longer to propagate.
DISCORD_GUILD_ID=replace-me

HEALTH_PORT=3000

# Private channel where RSVP and cancellation audit messages are posted.
RSVP_LOG_CHANNEL_ID=1530755171645132921

DATABASE_PATH=/data/bot.sqlite
