# Create a bot at https://discord.com/developers/applications and paste its token.
DISCORD_TOKEN=replace-me

# Recommended while developing: commands registered to one server appear quickly.
# Omit this to register global commands, which can take longer to propagate.
DISCORD_GUILD_ID=replace-me

HTTP_PORT=3000

# Optional fallbacks for guilds that have never run /config in Discord.
# RSVP_LOG_CHANNEL_ID=
# VERIFICATION_MESSAGE_URL=
# STUDENT_CONNECTION_ROLE_ID=
# STUDENT_NUMBER_EXEMPT_ROLE_ID=

# Neon PostgreSQL connection string. Keep this secret and never commit it.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Public origin that Stripe redirects to after Checkout. Do not add a trailing slash.
PUBLIC_BASE_URL=https://club.example.com

# Stripe secret key and the signing secret for the /stripe/webhook endpoint.
# Use sk_test_... and whsec_... values while developing.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional: enables /event create test_event:true with Stripe sandbox Checkout.
# Create a separate test-mode endpoint for /stripe/test-webhook.
STRIPE_TEST_SECRET_KEY=sk_test_replace_me
STRIPE_TEST_WEBHOOK_SECRET=whsec_replace_me
